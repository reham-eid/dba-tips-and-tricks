drop database;


--verify the oradata & fra folders is deleted 
cd /u03/FRA/ 
rm -rf * 

STARTUP NOMOUNT PFILE='/path/to/init<SID>.ora';                  >>>>> Restore with pfile 
STARTUP NOMOUNT PFILE='/u01/app/oracle/product/19.0.0/db_home/dbs/initMUSTTEST.ora';

rman target / 
RESTORE CONTROLFILE FROM '/mnt/BILD/Requested Backups_copied/2026-02-20-02-00-01/ControlFile_BILD.ctl'; 
-- Register backup pieces so RMAN can see them
CATALOG START WITH '/mnt/BILD/Requested Backups_copied/2026-02-20-02-00-01'; 
ALTER DATABASE MOUNT; 

-- Restore all datafiles from backup
RESTORE DATABASE;

--BEFORE RECOVER
--check if the online redo log groups created 
COLUMN group#     FORMAT 999999
COLUMN thread#    FORMAT 999999
COLUMN sequence#  FORMAT 999999999
COLUMN size_mb    FORMAT 999999
COLUMN members    FORMAT 999999
COLUMN status     FORMAT A15
COLUMN member     FORMAT A80

SELECT 
    l.group#,
    l.thread#,
    l.sequence#,
    ROUND(l.bytes/1024/1024) AS size_mb,
    l.members,
    l.status,
    lf.member
FROM 
    v$log l
JOIN 
    v$logfile lf
ON 
    l.group# = lf.group#
ORDER BY 
    l.group#;
--see -> INACTIVE logs and it's ok
-- Apply archived redo logs to make database consistent

RECOVER DATABASE; --archive logs now in /u03/FRA

-- Open database after recovery
