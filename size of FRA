
SELECT dest_id, destination, status, error FROM v$archive_dest_status; 

SELECT name 
, ceil( space_limit / 1024 / 1024/1024) SIZE_G 
, ceil( space_used / 1024 / 1024/1024) USED_G 
, ceil( space_reclaimable / 1024 / 1024/1024) RECLAIMABLE_M 
, decode( nvl( space_used, 0), 
0, 0 
, ceil ( ( ( space_used - space_reclaimable ) / space_limit) * 100) ) PCT_USED 
, ceil ( ( ( space_used) / space_limit) * 100)   REAL_PCT 
FROM v$recovery_file_dest ORDER BY name; 
